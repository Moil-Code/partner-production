# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Configuration (for license activation emails via Resend)
RESEND_API=your_resend_api_key_here
FROM_EMAIL=Buda Hive <noreply@budaedc.com>

# Application URL (for activation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Main API (Users API): server-only partner key and base URL.
# Never use a NEXT_PUBLIC_ name for the key: those are shipped to the browser.
MOIL_PARTNER_API_KEY=
MOIL_API_URL=
# Shared secret the main API sends as x-internal-api-key (either name works).
MOIL_INTERNAL_API_KEY=

# Cron secret for /api/licenses/send-reminders (Vercel Cron sends this as Bearer auth)
CRON_SECRET=
